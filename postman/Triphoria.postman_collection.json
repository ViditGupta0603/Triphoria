    {
      "name": "5. Supplier outage",
      "description": "Optional scenario from the brief: simulate one supplier being down, then both, then recover.",
      "item": [
        {
          "name": "Take Supplier B down",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"B is down\", () => pm.expect(pm.response.json().up).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/supplierB/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "supplierB",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"up\": false}",
              "options": {
                "raw": {
                  "language": "json"
