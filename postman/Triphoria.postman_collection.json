    {
      "name": "3. Best offers",
      "description": "",
      "item": [
        {
          "name": "delhi \u2014 de-duplicated best offers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Body is an array of offers with exactly name/price/supplier/commissionPct\", () => {",
                  "  pm.expect(body).to.be.an(\"array\");",
                  "  body.forEach(h => pm.expect(Object.keys(h).sort()).to.eql([\"commissionPct\", \"name\", \"price\", \"supplier\"]));",
                  "});",
                  "pm.test(\"Sorted by price ascending\", () => {",
                  "  const prices = body.map(h => h.price);",
                  "  pm.expect(prices).to.eql([...prices].sort((a, b) => a - b));",
                  "});",
                  "",
                  "pm.test(\"No duplicate hotel names\", () => {",
                  "  const names = body.map(h => h.name.toLowerCase());",
                  "  pm.expect(new Set(names).size).to.eql(names.length);",
                  "});",
                  "const by = Object.fromEntries(body.map(h => [h.name, h]));",
                  "pm.test(\"Holtin: Supplier B wins at 5340 (A is 6000)\", () => pm.expect(by[\"Holtin\"]).to.eql({ name: \"Holtin\", price: 5340, supplier: \"Supplier B\", commissionPct: 20 }));",
                  "pm.test(\"Radison: Supplier A wins at 5900 (B is 6100)\", () => pm.expect(by[\"Radison\"]).to.eql({ name: \"Radison\", price: 5900, supplier: \"Supplier A\", commissionPct: 13 }));",
                  "pm.test(\"Taj Palace: equal price, higher commission (B) wins\", () => pm.expect(by[\"Taj Palace\"].supplier).to.eql(\"Supplier B\"));",
                  "pm.test(\"Single-supplier hotels are kept\", () => {",
                  "  pm.expect(by[\"Lemon Tree\"].supplier).to.eql(\"Supplier A\");",
                  "  pm.expect(by[\"ITC Maurya\"].supplier).to.eql(\"Supplier B\");",
                  "});",
                  "pm.test(\"Not degraded\", () => pm.expect(pm.response.headers.has(\"X-Degraded-Suppliers\")).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": "Runs the Temporal workflow: both suppliers in parallel, dedupe by name, cheapest wins; result saved to Redis."
          }
        },
