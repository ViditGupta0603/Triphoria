                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test(\"Returns supplier-format hotels\", () => {",
                  "  pm.expect(a.length).to.be.above(0);",
                  "  a.forEach(h => pm.expect(h).to.have.all.keys(\"hotelId\", \"name\", \"price\", \"city\", \"commissionPct\"));",
                  "});",
                  "pm.collectionVariables.set(\"supplierANames\", JSON.stringify(a.map(h => h.name)));"
                ]
