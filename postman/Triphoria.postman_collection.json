              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const aNames = JSON.parse(pm.collectionVariables.get(\"supplierANames\") || \"[]\");",
                  "const overlap = b.filter(h => aNames.includes(h.name));",
                  "pm.test(\"At least two hotel names overlap with Supplier A\", () => pm.expect(overlap.length).to.be.at.least(2));"
                ]
