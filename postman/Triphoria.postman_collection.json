{
  "info": {
    "_postman_id": "d13e3446-87fd-5985-a6e3-f26a60221f94",
    "name": "Triphoria \u2014 Hotel Offer Orchestrator",
    "description": "Tests for the Hotel Offer Orchestrator (Node.js/TypeScript, Express, Temporal, Redis).\n\nRun the folders in order (Collection Runner or `newman run`). Set `baseUrl` if the API is not on http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "supplierANames",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "description": "Puts both mock suppliers in the 'up' state so the run is repeatable.",
      "item": [
        {
          "name": "Check baseUrl points at the Triphoria API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"baseUrl reaches the Triphoria API (GET /livez \u2192 {status: alive}). If this fails, set the baseUrl variable to the port the API runs on, e.g. http://localhost:3001\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
                  "  pm.expect(pm.response.json().status).to.eql(\"alive\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/livez",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livez"
              ]
            }
          }
        },
        {
          "name": "Reset Supplier A to up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Supplier A is up\", () => pm.expect(pm.response.json().up).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/supplierA/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "supplierA",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"up\": true}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reset Supplier B to up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Supplier B is up\", () => pm.expect(pm.response.json().up).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/supplierB/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "supplierB",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"up\": true}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "1. Health",
      "description": "Bonus: /health reports each supplier separately, plus Redis and Temporal.",
      "item": [
        {
          "name": "Health \u2014 all up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const h = pm.response.json();",
                  "pm.test(\"Overall status ok\", () => pm.expect(h.status).to.eql(\"ok\"));",
                  "pm.test(\"Both suppliers up\", () => {",
                  "  pm.expect(h.suppliers.supplierA.status).to.eql(\"up\");",
                  "  pm.expect(h.suppliers.supplierB.status).to.eql(\"up\");",
                  "});",
                  "pm.test(\"Redis and Temporal up\", () => {",
                  "  pm.expect(h.dependencies.redis.status).to.eql(\"up\");",
                  "  pm.expect(h.dependencies.temporal.status).to.eql(\"up\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
