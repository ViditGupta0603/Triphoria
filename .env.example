# Copy to .env for local (non-Docker) runs. All values shown are defaults.

PORT=3000
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300
DEGRADED_TTL_SECONDS=30

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
WORKFLOW_TIMEOUT_MS=15000

# Where the worker reaches the mock suppliers (served by the API).
SUPPLIER_BASE_URL=http://localhost:3000
SUPPLIER_TIMEOUT_MS=3000

# Start a mock supplier in the "down" state (can also be toggled at runtime).
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false

# Docker Compose only: host ports (change if one is already in use on your machine).
# API_PORT=3000
# REDIS_PORT=6379
# TEMPORAL_PORT=7233
# TEMPORAL_UI_PORT=8233

# Docker Compose only: pin the Temporal CLI image tag (defaults to latest).
# TEMPORAL_CLI_VERSION=latest
